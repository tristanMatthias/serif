<!DOCTYPE html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="serif">
<title>{{.Title}}</title>
<script>
{{.ThemeInit}}</script>
<style>
{{.Style}}

/* ---- syntax highlighting (chroma) ---- */
{{.ChromaCSS}}
</style>
</head>
<body>
{{.ThemeToggle}}

<main class="page">
  <article class="prose">
{{.Body}}
  </article>
  <footer class="page-footer">{{.Footer}}</footer>
</main>

<script>
{{.ThemeJS}}
(function () {
  /* Add clickable anchors to headings that have ids. */
  document.querySelectorAll(".prose h2[id], .prose h3[id], .prose h4[id]").forEach(function (h) {
    var a = document.createElement("a");
    a.className = "anchor";
    a.href = "#" + h.id;
    a.textContent = "#";
    a.setAttribute("aria-label", "Link to this section");
    h.appendChild(a);
  });
})();
</script>
</body>
</html>
